# AI News Dashboard environment template
# Copy to .env and fill in values.

# App
APP_NAME=AI News Dashboard
APP_VERSION=1.0.0
DEBUG=false

# Database
# Local Docker default:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/ainews
# Render/hosted Postgres example:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# LLM (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional legacy keys (leave blank unless used)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Email broadcast (optional; leave blank to simulate)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ai-news@example.com

# LinkedIn (optional; leave blank to simulate)
LINKEDIN_ACCESS_TOKEN=

# WhatsApp Business API (optional; leave blank to simulate)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=

# Scheduler
FETCH_INTERVAL_MINUTES=15
MAX_NEWS_AGE_DAYS=7

# Deduplication
DEDUP_SIMILARITY_THRESHOLD=0.85

# CORS (JSON array format for pydantic-settings)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
